# Example settings for a local CC Agent. `npm start` (scripts/start.mjs) creates its
# own secrets (JWT secret, first admin password, push keys) in the data folder, so
# nothing secret needs to go here. Copy to server/.env only if you need to change
# a value below; keep that file out of Git.

# The HTTPS address people open CC Agent at (a reverse proxy or tunnel in front of
# this service). Passkeys belong to this address: change it before registering any.
CC_AGENT_PUBLIC_ORIGIN=https://cc-agent.example.com

# The port the service listens on, on this machine only (127.0.0.1).
CC_AGENT_PORT=4280

# Where runtime data lives (accounts, agents, workspaces; with this set, the audit log
# too). Default: .local/ inside the repository, with the audit log in server/logs/. A value already in the environment wins over this file.
# CC_AGENT_DATA_DIR=/absolute/path/to/cc-agent-data

# Optional. Extra absolute paths no agent may ever write, colon-separated.
# CC_AGENT_PROTECTED_PATHS=/opt/my-tools:/srv/secrets

# Peer link (docs/PEER-LINK.md), on the calling machine only: the SSH config file and
# the host in it to call. Leave both unset on the answering machine.
# CC_AGENT_PEER_SSH_CONFIG=/absolute/path/to/.ssh/peer-b.config
# CC_AGENT_PEER_SSH_HOST=peer-b

# CC_AGENT_DEV=1 (trust the dev server's port) is read from the command line only;
# a line here is ignored.

# Session / presence (all optional — defaults shown; uncomment to override).
# Sliding session: a user stays signed in as long as they're active;
# SESSION_IDLE_DAYS of inactivity signs them out. SESSION_MAX_DAYS is the absolute
# backstop. ONLINE_WINDOW_MINUTES is Manage Users' "active" threshold.
# SESSION_IDLE_DAYS=15
# SESSION_MAX_DAYS=400
# ONLINE_WINDOW_MINUTES=5
